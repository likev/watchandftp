# Feature Toggles
ENABLE_WATCH_UPLOAD=true
PERSISTENT_CONNECTION=false
USE_ATOMIC_UPLOAD=true
INCLUDE_HIDDEN_FILES=false

# Path & FTP Server Settings
WATCH_DIR=C:/path/to/local/dir
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=username
# NOTE: If your password contains special characters like # ' " or spaces, wrap it in double quotes:
# Example: FTP_PASSWORD="p@ss#word'123\""
FTP_PASSWORD=password
FTP_REMOTE_DIR=/remote/target/dir
FTP_SECURE=false
FTP_TIMEOUT=30000
STABILITY_THRESHOLD=2000
POLL_INTERVAL=100

# Auto Cleanup Settings
MAX_AGE_DAYS=1
AUTO_DELETE_LOCAL=true
AUTO_DELETE_REMOTE=false
AUTO_DELETE_RECURSIVE=false
CLEANUP_INTERVAL_MINUTES=60
